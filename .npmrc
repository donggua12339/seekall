# === SeekAll 项目级 pnpm 配置（入库，clone 即生效）===

# CC Haha 捆绑 Node v18，而本项目要求 Node 20+；放宽 engine 校验，
# 避免用 CC 内置 node 跑 pnpm 时因 engine 不匹配报错。
engine-strict=false

# 【关键·Windows 兼容】强制 pnpm 用 hoisted（扁平）布局，像 npm 一样，
# 而非 pnpm 默认的 symlink/junction + .pnpm 虚拟存储。
# 默认布局在 Windows 上有两大杀手：
#   1) 大量 symlink/junction → 7-zip 压缩、CC 更新遍历目录时直接报错/卡死
#   2) .pnpm 虚拟路径嵌套极深 → 叠加本项目路径前缀轻松超 Windows MAX_PATH(260)
# hoisted 后无 symlink、路径大幅变浅，CC 更新/7-zip 不再因 node_modules 报错。
node-linker=hoisted
