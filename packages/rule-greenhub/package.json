{
  "name": "@seekall/rule-greenhub",
  "version": "0.2.0",
  "description": "SeekAll L2 规则 - 全网绿色资源聚合搜索（果核剥壳/423down/殁漂遥/乐软等）",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
