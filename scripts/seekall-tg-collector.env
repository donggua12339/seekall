# 觅源 SeekAll - TG Collector 环境变量
# 复制到 /opt/seekall/apps/tg-collector/.env
# TG Bot Token 向 @BotFather 申请，channels 填要监听的频道用户名（不带 @）

# Telegram Bot Token（必填）
TG_BOT_TOKEN=

# 监听的频道列表（逗号分隔，去掉 @）
# 例：TG_CHANNELS=fakawangpan,share_channel,movie_channel
TG_CHANNELS=

# Meilisearch（统一配置）
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=meili_master_key_change_me

# 日志级别（debug | info | warn | error）
LOG_LEVEL=info
