# ============================================================
# seekall.winmelon.cn - SeekAll 反代（直连 docker 容器）
# 链路: 用户 -> CF -> 源 <REDACTED_SERVER_IP>:443 -> 雨云 nginx (本文件)
#       -> 172.18.0.5:7301 (NestJS API)
#       -> 172.18.0.6:3000 (Nuxt 3 SSR)
# 创建: 2026-07-16
# 历史: 最初设计走 Caddy 中转，但 Caddy 在容器里 auto_https 行为难调，
#       改为 nginx 直连容器网络（更稳定 + 少一层代理）
# ============================================================

# --- HTTP -> HTTPS 重定向 ---
server {
    listen 80;
    listen [::]:80;
    server_name seekall.winmelon.cn;

    # ACME http-01 challenge 兜底
    location /.well-known/acme-challenge/ {
        root /var/www/winmelon.cn;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS 主站 ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name seekall.winmelon.cn;

    # 通配符证书 *.winmelon.cn 已覆盖此域名
    ssl_certificate     /etc/nginx/ssl/winmelon.cn.crt;
    ssl_certificate_key /etc/nginx/ssl/winmelon.cn.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # 安全头
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    more_clear_headers Server;

    # gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # 客户端上传大小（资源 URL 可能很长）
    client_max_body_size 10M;

    # 长超时：搜索 + SSR 渲染
    proxy_connect_timeout 30s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    # API：直接代理到 seekall-api 容器（7301）
    location /api/ {
        proxy_pass http://172.18.0.5:7301;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Swagger 文档（指向 API）
    location /docs {
        proxy_pass http://172.18.0.5:7301;
        proxy_set_header Host $host;
    }
    location /docs-json {
        proxy_pass http://172.18.0.5:7301;
        proxy_set_header Host $host;
    }

    # 前端 SSR：所有非 /api/* 请求走 Nuxt 3
    location / {
        proxy_pass http://172.18.0.6:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # 健康检查端点
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # 禁止访问隐藏文件
    location ~ /\. {
        deny all;
    }
}