# 觅源 SeekAll - 生产环境配置模板
# 用法：cp .env.production .env，然后填写实际值
#
# 生成强随机密钥：
#   openssl rand -hex 32        # JWT Secret / Meilisearch Key
#   openssl rand -base64 24     # MySQL 密码

# ====== 基础 ======
NODE_ENV=production
APP_PORT=7301
WEB_PORT=7300
API_BASE_URL=http://localhost:7301

# Swagger 文档（prod 建议关闭，但 Z++ 内部用可以开着）
SWAGGER_ENABLED=false

# ====== 数据库（生产必须改密码）======
DATABASE_URL=mysql://seekall:CHANGE_ME_STRONG_PASSWORD@localhost:3306/seekall
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_DATABASE=seekall
MYSQL_USER=seekall
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_PORT=3306

# ====== Redis ======
REDIS_URL=redis://localhost:6379

# ====== Meilisearch ======
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=CHANGE_ME_32_HEX_CHARS
MEILISEARCH_PORT=7700

# ====== JWT（生产必须用强随机，至少 32 字符）======
JWT_ACCESS_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ====== 邮件 - Resend ======
MAIL_PROVIDER=resend
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
# 部署后在 Resend 验证 seekall.winmelon.cn 域名，改回 noreply@seekall.winmelon.cn
MAIL_FROM=SeekAll <onboarding@resend.dev>

# ====== 邮件 - QQ 邮箱 SMTP（备）======
QQ_MAIL_HOST=smtp.qq.com
QQ_MAIL_PORT=465
QQ_MAIL_USER=your_qq@qq.com
QQ_MAIL_PASSWORD=CHANGE_ME_QQ_MAIL_AUTH_CODE
QQ_MAIL_FROM=your_qq@qq.com

# ====== 域名 ======
APP_DOMAIN=seekall.winmelon.cn
ADMIN_DOMAIN=admin.seekall.winmelon.cn

# ====== Provider ======
PANSOU_API_URLS=https://so.252035.xyz
PANSOU_API_URL=https://so.252035.xyz
PANSOU_API_KEY=
PANSOU_TIMEOUT=10000
QUARK_COOKIE=
QUARK_TIMEOUT=10000
MAGNET_SITE_URL=
MAGNET_TIMEOUT=10000

# ====== 搜索 ======
SEARCH_GLOBAL_TIMEOUT=15000
SEARCH_CACHE_TTL=3600
SEARCH_DEFAULT_PAGE_SIZE=20
SEARCH_MAX_PAGE_SIZE=50

# ====== 限流 ======
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_SEARCH=30
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_PASSWORD_RESET=3

# ====== 失效链接检测 ======
LINK_CHECKER_CONCURRENCY=10
LINK_CHECKER_TIMEOUT=5000
LINK_CHECKER_INTERVAL=0 0 3 * * *

# ====== 邀请码 ======
INVITE_CODE_LENGTH=8
INVITE_CODE_EXPIRES_DAYS=0

# ====== 用户 ======
USER_SEARCH_HISTORY_FREE=50
USER_SEARCH_HISTORY_PAID=500

# ====== Swagger（生产关闭）======
SWAGGER_ENABLED=false

# ====== Sentry 监控 ======
SENTRY_DSN=CHANGE_ME_SENTRY_DSN
NUXT_PUBLIC_SENTRY_DSN=CHANGE_ME_SENTRY_DSN
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
APP_VERSION=0.2.0

# ====== Uptime 监控 ======
UPTIME_ALERT_EMAIL=<REDACTED_ADMIN_EMAIL>

# ====== 日志 ======
LOG_LEVEL=info
