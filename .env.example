# ====== 基础 ======
NODE_ENV=development
APP_PORT=7301
WEB_PORT=7300
API_BASE_URL=http://localhost:7301

# ====== 数据库 ======
DATABASE_URL=mysql://seekall:seekall_password@localhost:3306/seekall
MYSQL_ROOT_PASSWORD=<REDACTED_MYSQL_PASS>
MYSQL_DATABASE=seekall
MYSQL_USER=seekall
MYSQL_PASSWORD=seekall_password
MYSQL_PORT=3306

# ====== Redis ======
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ====== Meilisearch ======
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=meili_master_key_change_me
MEILISEARCH_PORT=7700

# ====== JWT ======
JWT_ACCESS_SECRET=jwt_access_secret_change_me_at_least_32_chars
JWT_REFRESH_SECRET=jwt_refresh_secret_change_me_at_least_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ====== 邮件 - Resend（主）======
MAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=SeekAll <noreply@seekall.winmelon.cn>

# ====== 邮件 - QQ 邮箱 SMTP（备）======
# 当 MAIL_PROVIDER=qq 时使用
QQ_MAIL_HOST=smtp.qq.com
QQ_MAIL_PORT=465
QQ_MAIL_USER=your_qq@qq.com
QQ_MAIL_PASSWORD=your_qq_smtp_auth_code
QQ_MAIL_FROM=your_qq@qq.com

# ====== 域名 ======
APP_DOMAIN=seekall.winmelon.cn
ADMIN_DOMAIN=admin.seekall.winmelon.cn

# ====== Provider ======
PANSOU_API_URL=https://so.252035.xyz
PANSOU_API_KEY=
PANSOU_TIMEOUT=10000
QUARK_COOKIE=
QUARK_TIMEOUT=10000
MAGNET_SITE_URL=
MAGNET_TIMEOUT=10000

# ====== 搜索 ======
SEARCH_GLOBAL_TIMEOUT=15000
SEARCH_CACHE_TTL=3600
SEARCH_DEFAULT_PAGE_SIZE=20
SEARCH_MAX_PAGE_SIZE=50

# ====== 限流 ======
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_SEARCH=30
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_PASSWORD_RESET=3

# ====== 失效链接检测 ======
LINK_CHECKER_CONCURRENCY=10
LINK_CHECKER_TIMEOUT=5000
LINK_CHECKER_INTERVAL=0 0 3 * * *  # 每天 3:00 执行

# ====== 邀请码 ======
INVITE_CODE_LENGTH=8
INVITE_CODE_EXPIRES_DAYS=0  # 0 = 永不过期

# ====== 用户 ======
USER_SEARCH_HISTORY_FREE=50
USER_SEARCH_HISTORY_PAID=500

# ====== Swagger ======
SWAGGER_ENABLED=true  # prod 设为 false

# ====== 日志 ======
LOG_LEVEL=debug  # prod 设为 info

# ====== v0.5 WM 发卡网 webhook ======
# WM 付款成功后回调 SeekAll，签名算法：HMAC-SHA256(secret, "${wmOrderId}|${tier}|${amount}")
WM_WEBHOOK_SECRET=  # 必填，否则 webhook 验证失败

# ====== v0.5 P2-1 DMCA 通知 ======
# DMCA Takedown Notice 提交后，admin 收到邮件通知（不配则只入库不发邮件）
DMCA_ADMIN_EMAIL=1660069758@qq.com
