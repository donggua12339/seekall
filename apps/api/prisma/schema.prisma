// 觅源 SeekAll v0.5 - Prisma Schema
// 极简 BaaS：5 张表（User / License / Rule / AuditLog / Config）+ LicenseClaim（防羊毛）
// 数据库：MySQL 8
// 命名约定：snake_case 复数表名

generator client {
  provider      = "prisma-client-js"
  // Alpine 镜像（musl libc）需要 linux-musl-openssl-3.0.x 的 Prisma engine binary
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ====== 枚举 ======

enum UserRole {
  super_admin
  user
}

enum UserStatus {
  pending_verification
  active
  banned
  deleted
}

/// 会员档位：免费 / 试用 / 月卡 / 永久
enum LicenseTier {
  trial
  monthly
  lifetime
}

/// License code 状态
enum LicenseStatus {
  unused
  used
  disabled
}

/// 规则风险评级（L0-L4）
enum RuleRiskLevel {
  l0
  l1
  l2
  l3
  l4
}

/// 规则市场状态
enum RuleStatus {
  pending_review
  published
  taken_down
  banned
}

// ====== 用户系统 ======

model User {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  username           String    @unique @db.VarChar(32)
  email              String    @unique @db.VarChar(128)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  role               UserRole  @default(user)
  isPaid             Boolean   @default(false) @map("is_paid")
  paidUntil          DateTime? @map("paid_until")
  tier               LicenseTier? @map("tier")
  status             UserStatus @default(pending_verification)
  bannedReason       String?   @map("banned_reason") @db.VarChar(255)
  badge              String?   @db.VarChar(64)
  avatarUrl          String?   @map("avatar_url") @db.VarChar(255)
  bio                String?   @db.VarChar(200)
  emailVerifyToken   String?   @map("email_verify_token") @db.VarChar(64)
  emailVerifiedAt    DateTime? @map("email_verified_at")
  passwordResetToken String?   @map("password_reset_token") @db.VarChar(64)
  passwordResetExpires DateTime? @map("password_reset_expires")
  lastLoginAt        DateTime? @map("last_login_at")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // v0.5 关系
  licensesGenerated  License[]     @relation("LicenseGeneratedBy")
  licensesUsed       License[]     @relation("LicenseUsedBy")
  licenseClaims      LicenseClaim[]
  rulesAuthored      Rule[]        @relation("RuleAuthoredBy")
  auditLogs          AdminAuditLog[] @relation("AdminAuditActor")
  dmcaNoticesHandled DmcaNotice[]  @relation("DmcaNoticeHandler")
  ruleSubscriptions  RuleSubscription[]
  ruleReviews        RuleReview[]  @relation("RuleReviewReviewer")

  @@index([status])
  @@index([isPaid])
  @@map("users")
}

// ====== 会员授权系统 ======

model License {
  id           BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  code         String       @unique @db.VarChar(64)
  tier         LicenseTier
  status       LicenseStatus @default(unused)
  generatedBy  BigInt?      @map("generated_by") @db.UnsignedBigInt
  generatedByUser User?    @relation("LicenseGeneratedBy", fields: [generatedBy], references: [id])
  usedBy       BigInt?      @map("used_by") @db.UnsignedBigInt
  usedByUser   User?        @relation("LicenseUsedBy", fields: [usedBy], references: [id])
  usedAt       DateTime?    @map("used_at")
  note         String?      @db.VarChar(255)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  claims       LicenseClaim[]

  @@index([tier])
  @@index([status])
  @@index([generatedBy])
  @@map("licenses")
}

/// License 领取记录（用于 trial 防羊毛：每账号限领 1 次试用）
model LicenseClaim {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt   @map("user_id") @db.UnsignedBigInt
  user         User     @relation(fields: [userId], references: [id])
  licenseId    BigInt   @map("license_id") @db.UnsignedBigInt
  license      License  @relation(fields: [licenseId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, licenseId])
  @@index([userId])
  @@map("license_claims")
}

// ====== 规则市场系统 ======

model Rule {
  id           BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  npmPackage   String        @unique @map("npm_package") @db.VarChar(128)
  riskLevel    RuleRiskLevel @map("risk_level")
  description  String        @db.VarChar(500)
  authorId     BigInt        @map("author_id") @db.UnsignedBigInt
  author       User          @relation("RuleAuthoredBy", fields: [authorId], references: [id])
  status       RuleStatus    @default(pending_review)
  version      String        @db.VarChar(32) @default("1.0.0")
  takedownCount Int          @default(0) @map("takedown_count")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  dmcaNotices  DmcaNotice[]
  subscriptions RuleSubscription[]
  reviews       RuleReview[]

  @@index([riskLevel])
  @@index([status])
  @@index([authorId])
  @@map("rules")
}

// ====== 审计日志（admin 操作 + takedown 记录合并）======

model AdminAuditLog {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  adminId      BigInt   @map("admin_id") @db.UnsignedBigInt
  admin        User     @relation("AdminAuditActor", fields: [adminId], references: [id])
  action       String   @db.VarChar(64)
  targetType   String   @map("target_type") @db.VarChar(32)
  targetId     BigInt?  @map("target_id") @db.UnsignedBigInt
  detail       Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

// ====== 系统配置（key-value）======

model Config {
  key         String   @id @db.VarChar(64)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("configs")
}

// ====== DMCA Takedown Notice（合规证据，永不删除）======
//
// 用途：公众通过 POST /api/v1/dmca/notice 提交版权侵权举报
// 字段对齐 DMCA §512(c) Takedown Notice 7 项必填要素
// 处理流程：pending -> verified / rejected -> actioned（关联 Rule.takedown）
// 透明度报告：每月 1 号统计上月数据

model DmcaNotice {
  id                  BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  // 侵权 URL（规则市场中的规则详情页 URL，或外部资源 URL）
  infringingUrl       String   @map("infringing_url") @db.VarChar(500)
  // 关联到具体 Rule（若提交者能定位到）。可空：admin 复核时再关联
  ruleId              BigInt?  @map("rule_id") @db.UnsignedBigInt
  rule                Rule?    @relation(fields: [ruleId], references: [id])
  // 原作品信息
  originalTitle       String   @map("original_title") @db.VarChar(255)
  copyrightOwner      String   @map("copyright_owner") @db.VarChar(255)
  // 举报人联系方式
  reporterEmail       String   @map("reporter_email") @db.VarChar(128)
  reporterRole        DmcaReporterRole @map("reporter_role")
  // 两项法定声明（必须为 true 才接受）
  goodFaithStatement  Boolean  @default(false) @map("good_faith_statement")
  accuracyStatement   Boolean  @default(false) @map("accuracy_statement")
  electronicSignature String   @map("electronic_signature") @db.VarChar(128)
  // 可选额外说明
  notes               String?  @db.Text
  // 处理状态
  status              DmcaNoticeStatus @default(pending)
  handlerAdminId      BigInt?  @map("handler_admin_id") @db.UnsignedBigInt
  handlerAdmin        User?    @relation("DmcaNoticeHandler", fields: [handlerAdminId], references: [id])
  handlerNote         String?  @map("handler_note") @db.VarChar(500)
  handledAt           DateTime? @map("handled_at")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([ruleId])
  @@index([createdAt])
  @@index([handlerAdminId])
  @@map("dmca_notices")
}

enum DmcaReporterRole {
  owner
  agent
}

enum DmcaNoticeStatus {
  pending
  verified
  actioned
  rejected
}

// ====== 规则订阅（M2 从 AdminAuditLog 拆出）======
//
// 用户订阅一条规则，SDK 拉取订阅列表用
// 幂等约束：@@unique([userId, ruleId]) - 重复订阅不会产生新记录
// 取消订阅直接 delete 行

model RuleSubscription {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  user      User     @relation(fields: [userId], references: [id])
  ruleId    BigInt   @map("rule_id") @db.UnsignedBigInt
  rule      Rule     @relation(fields: [ruleId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, ruleId])
  @@index([userId])
  @@index([ruleId])
  @@map("rule_subscriptions")
}

// ====== 规则评审（M2 从 AdminAuditLog 拆出）======
//
// E 社群评审工作流：L2 规则评审
// - 评审员需付费会员
// - 不能评审自己提交的规则
// - ≥3 赞成 -> admin 终审
// 幂等约束：@@unique([ruleId, reviewerId]) - 一人一票

model RuleReview {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  ruleId     BigInt   @map("rule_id") @db.UnsignedBigInt
  rule       Rule     @relation(fields: [ruleId], references: [id])
  reviewerId BigInt   @map("reviewer_id") @db.UnsignedBigInt
  reviewer   User     @relation("RuleReviewReviewer", fields: [reviewerId], references: [id])
  approve    Boolean
  comment    String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([ruleId, reviewerId])
  @@index([ruleId])
  @@index([reviewerId])
  @@map("rule_reviews")
}
