// 觅源 SeekAll v0.5 - Prisma Schema
// 极简 BaaS：5 张表（User / License / Rule / AuditLog / Config）+ LicenseClaim（防羊毛）
// 数据库：MySQL 8
// 命名约定：snake_case 复数表名

generator client {
  provider      = "prisma-client-js"
  // Alpine 镜像（musl libc）需要 linux-musl-openssl-3.0.x 的 Prisma engine binary
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ====== 枚举 ======

enum UserRole {
  super_admin
  user
}

enum UserStatus {
  pending_verification
  active
  banned
  deleted
}

/// 会员档位：免费 / 试用 / 月卡 / 永久
enum LicenseTier {
  trial
  monthly
  lifetime
}

/// License code 状态
enum LicenseStatus {
  unused
  used
  disabled
}

/// 规则风险评级（L0-L4）
enum RuleRiskLevel {
  l0
  l1
  l2
  l3
  l4
}

/// 规则市场状态
enum RuleStatus {
  pending_review
  published
  taken_down
  banned
}

// ====== 用户系统 ======

model User {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  username           String    @unique @db.VarChar(32)
  email              String    @unique @db.VarChar(128)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  role               UserRole  @default(user)
  isPaid             Boolean   @default(false) @map("is_paid")
  paidUntil          DateTime? @map("paid_until")
  tier               LicenseTier? @map("tier")
  status             UserStatus @default(pending_verification)
  bannedReason       String?   @map("banned_reason") @db.VarChar(255)
  badge              String?   @db.VarChar(64)
  avatarUrl          String?   @map("avatar_url") @db.VarChar(255)
  bio                String?   @db.VarChar(200)
  emailVerifyToken   String?   @map("email_verify_token") @db.VarChar(64)
  emailVerifiedAt    DateTime? @map("email_verified_at")
  passwordResetToken String?   @map("password_reset_token") @db.VarChar(64)
  passwordResetExpires DateTime? @map("password_reset_expires")
  lastLoginAt        DateTime? @map("last_login_at")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // v0.5 关系
  licensesGenerated  License[]     @relation("LicenseGeneratedBy")
  licensesUsed       License[]     @relation("LicenseUsedBy")
  licenseClaims      LicenseClaim[]
  rulesAuthored      Rule[]        @relation("RuleAuthoredBy")
  auditLogs          AdminAuditLog[] @relation("AdminAuditActor")

  @@index([status])
  @@index([isPaid])
  @@map("users")
}

// ====== 会员授权系统 ======

model License {
  id           BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  code         String       @unique @db.VarChar(32)
  tier         LicenseTier
  status       LicenseStatus @default(unused)
  generatedBy  BigInt?      @map("generated_by") @db.UnsignedBigInt
  generatedByUser User?    @relation("LicenseGeneratedBy", fields: [generatedBy], references: [id])
  usedBy       BigInt?      @map("used_by") @db.UnsignedBigInt
  usedByUser   User?        @relation("LicenseUsedBy", fields: [usedBy], references: [id])
  usedAt       DateTime?    @map("used_at")
  note         String?      @db.VarChar(255)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  claims       LicenseClaim[]

  @@index([tier])
  @@index([status])
  @@index([generatedBy])
  @@map("licenses")
}

/// License 领取记录（用于 trial 防羊毛：每账号限领 1 次试用）
model LicenseClaim {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt   @map("user_id") @db.UnsignedBigInt
  user         User     @relation(fields: [userId], references: [id])
  licenseId    BigInt   @map("license_id") @db.UnsignedBigInt
  license      License  @relation(fields: [licenseId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, licenseId])
  @@index([userId])
  @@map("license_claims")
}

// ====== 规则市场系统 ======

model Rule {
  id           BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  npmPackage   String        @unique @map("npm_package") @db.VarChar(128)
  riskLevel    RuleRiskLevel @map("risk_level")
  description  String        @db.VarChar(500)
  authorId     BigInt        @map("author_id") @db.UnsignedBigInt
  author       User          @relation("RuleAuthoredBy", fields: [authorId], references: [id])
  status       RuleStatus    @default(pending_review)
  version      String        @db.VarChar(32) @default("1.0.0")
  takedownCount Int          @default(0) @map("takedown_count")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([riskLevel])
  @@index([status])
  @@index([authorId])
  @@map("rules")
}

// ====== 审计日志（admin 操作 + takedown 记录合并）======

model AdminAuditLog {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  adminId      BigInt   @map("admin_id") @db.UnsignedBigInt
  admin        User     @relation("AdminAuditActor", fields: [adminId], references: [id])
  action       String   @db.VarChar(64)
  targetType   String   @map("target_type") @db.VarChar(32)
  targetId     BigInt?  @map("target_id") @db.UnsignedBigInt
  detail       Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

// ====== 系统配置（key-value）======

model Config {
  key         String   @id @db.VarChar(64)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("configs")
}
