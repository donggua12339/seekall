[Unit]
Description=SeekAll DHT Magnet Crawler
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/seekall/apps/dht-crawler
EnvironmentFile=/opt/seekall/apps/dht-crawler/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=10
StandardOutput=append:/var/log/seekall/dht-crawler.log
StandardError=append:/var/log/seekall/dht-crawler.log

[Install]
WantedBy=multi-user.target
